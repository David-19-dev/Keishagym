# Supabase backend (accounts + sync). Copy to .env.local and fill in; leave empty to build
# without accounts. The anon key is public by design — never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Exercise photos. Empty = served next to the app from ex/ (docker compose downloads them).
# Set it to a CDN when the photos are hosted elsewhere; the mobile build does this.
VITE_EX_BASE=

# 3D demo videos, for the exercises listed in src/lib/exercise-videos.js.
# Empty = served next to the app from vid/.
VITE_VID_BASE=
