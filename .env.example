# Copy this file to ".env", then: docker compose up -d
#
# This compose file serves the app and the exercise photos. Accounts, sync and the AI Coach
# live in Supabase — see docs/SELF_HOSTING.md and docs/COACH_DEPLOY.md.

# Port the app is served on (http://localhost:8080 by default).
WEB_PORT=8080

# ── Supabase ───────────────────────────────────────────────────────────────
# Compiled into the app at build time. Both values are public by design: the anon key is
# meant to sit in a browser, and row-level security is what protects the data. NEVER put the
# service_role key here.
#
#   VITE_SUPABASE_URL=https://supabase.example.com
#   VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
#
# Leave them empty to build a device-only app: no accounts, no sync, everything stays in the
# browser it runs in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
